# Copy to .env (local) or set in your hosting dashboard (production).

# Address of the EventGhar backend, with no trailing slash.
VITE_API_URL=http://localhost:5001

# Google Sign-In. Same OAuth Client ID as the backend's GOOGLE_CLIENT_ID —
# create it at https://console.cloud.google.com/apis/credentials (type: Web
# application) and add this site's URL under "Authorized JavaScript origins".
VITE_GOOGLE_CLIENT_ID=

# Public contact details. Anything left empty is simply hidden on the site,
# so visitors never see a placeholder. Fill these in before you launch.
VITE_SUPPORT_EMAIL=support@eventghar.com
VITE_CONTACT_PHONE=
VITE_INSTAGRAM_URL=
VITE_FACEBOOK_URL=
VITE_TWITTER_URL=
